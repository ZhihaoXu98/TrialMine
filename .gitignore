data/raw/
data/processed/
data/training/
data/*.db
# Ignore everything under models/ (weights are too big for git — tracked via DVC),
# *except* model directories themselves and their metadata.json files.
# Git's pattern grammar requires this three-rule form: ignoring "/models/" alone
# would block "!models/**/metadata.json" because the parent dir is excluded.
/models/**
!models/**/
!models/**/metadata.json
*.faiss
data/faiss_*.index
data/faiss_*.json
mlflow.db
.env
mlruns/
.DS_Store
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.venv/
