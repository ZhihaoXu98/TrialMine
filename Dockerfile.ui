# syntax=docker/dockerfile:1.7
# Streamlit UI for TrialMine. Single-stage — no native deps, only streamlit + httpx.

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # Streamlit telemetry off — fewer outbound calls, quieter logs.
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_PORT=8501

# wget is used by the compose healthcheck against /_stcore/health.
RUN apt-get update \
    && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip \
    && pip install \
       "streamlit>=1.40,<2" \
       "httpx>=0.27,<1"

# Run as non-root.
RUN useradd --create-home --shell /usr/sbin/nologin streamlit
USER streamlit
WORKDIR /app

# Ship only the UI module — keeps the image small and avoids leaking
# unrelated source files into a public-facing container.
COPY --chown=streamlit:streamlit src/TrialMine/ui/ /app/ui/

EXPOSE 8501

CMD ["streamlit", "run", "/app/ui/app.py"]
